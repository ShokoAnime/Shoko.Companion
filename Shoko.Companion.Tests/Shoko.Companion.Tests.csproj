<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>
    <!--
      Mirrors the main project's conditional Windows platform identity so the
      ProjectReference restores compatibly on Windows hosts (the main project
      becomes net10.0-windows10.0.19041 there). On Linux/macOS hosts the
      condition is false and nothing changes.
    -->
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-')) OR $([MSBuild]::IsOSPlatform('Windows'))">
        <TargetPlatformIdentifier>windows</TargetPlatformIdentifier>
        <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Shoko.Companion\Shoko.Companion.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Moq" Version="4.21.0" />
    </ItemGroup>
</Project>
