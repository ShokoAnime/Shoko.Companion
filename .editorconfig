root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,axaml,xml,csproj}]
indent_size = 2

[*.cs]
max_line_length = 160

# Missing XML doc comments on public members → build error
dotnet_diagnostic.CS1591.severity = error

# Prefer var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Braces on new lines (Allman)
csharp_new_line_before_open_brace = all

# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion

# Naming: instance/static fields => _camelCase (handled by convention in this project)
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _
