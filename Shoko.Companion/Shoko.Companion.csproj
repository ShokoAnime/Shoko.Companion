<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.1.0</Version>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
        <Deterministic>false</Deterministic>
        <AssemblyName>shoko-companion</AssemblyName>
        <Product>Shoko Companion</Product>
        <Company>Shoko</Company>
        <Copyright>Copyright © 2026</Copyright>
        <LangVersion>latest</LangVersion>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <Nullable>enable</Nullable>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!--
          Always generate XML docs so CS1591 enforcement works in any configuration.
          Embed PDB in the assembly so there's no loose .pdb file during dev.
          A post-publish target strips .pdb/.xml from the publish output.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <!--
          Single-file publish: packs all managed + native DLLs into one binary.
          Native libraries (Skia, HarfBuzz, etc.) are extracted to a temp dir on first launch.
          Usage:
            dotnet publish -c Release -r linux-x64   (or win-x64 / osx-arm64)
            dotnet publish -c Release -r linux-x64 -p:SelfContained=true   (bundles .NET runtime too)
        -->
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <NoWarn>$(NoWarn);NU1903</NoWarn>
        <!--
          CS1591 is elevated to error via .editorconfig so every public member
          must carry an XML doc comment. The EnforceDocumentation property
          exists for CI scenarios that want to extend this to other rules.
        -->
        <WarningsAsErrors Condition="'$(EnforceDocumentation)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.12" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
        <PackageReference Include="NLog" Version="6.1.3" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Shoko.Companion.Tests" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="icon.ico" />
    </ItemGroup>
    <ItemGroup>
        <!-- Embedded PNG used for Linux notification / desktop-entry icons. -->
        <EmbeddedResource Include="icon.png">
            <LogicalName>shoko-companion.icon.png</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <!--
      Strip .pdb and .xml from publish output regardless of configuration.
      This keeps the published single-file binary clean while preserving doc
      generation (CS1591 enforcement) and debug symbols in all build configs.
    -->
    <Target Name="CleanPublishOutput" AfterTargets="Publish">
        <ItemGroup>
            <_PublishExtraFiles Include="$(PublishDir)*.pdb" />
            <_PublishExtraFiles Include="$(PublishDir)*.xml" />
        </ItemGroup>
        <Delete Files="@(_PublishExtraFiles)" />
    </Target>
</Project>
