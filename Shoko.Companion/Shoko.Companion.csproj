<Project Sdk="Microsoft.NET.Sdk">
    <!-- Opt out of Avalonia's build telemetry: its stats task only runs while UsedAvaloniaProducts is set. -->
    <PropertyGroup>
        <UsedAvaloniaProducts />
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Version>0.4.1</Version>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64</RuntimeIdentifiers>
        <Deterministic>false</Deterministic>
        <AssemblyName>shoko-companion</AssemblyName>
        <Product>Shoko Companion</Product>
        <Company>Shoko</Company>
        <Copyright>Copyright © 2026</Copyright>
        <LangVersion>latest</LangVersion>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <Nullable>enable</Nullable>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!--
          Always generate XML docs so CS1591 enforcement works in any configuration.
          Embed PDB in the assembly so there's no loose .pdb file during dev.
          A post-publish target strips .pdb/.xml from the publish output.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <!--
          Single-file publish: packs all managed + native DLLs into one binary.
          Native libraries (Skia, HarfBuzz, etc.) are extracted to a temp dir on first launch.
          Usage:
            dotnet publish -c Release -r linux-x64   (or win-x64 / osx-arm64)
            dotnet publish -c Release -r linux-x64 -p:SelfContained=true   (bundles .NET runtime too)
        -->
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <NoWarn>$(NoWarn);NU1903</NoWarn>
        <!--
          CS1591 is elevated to error via .editorconfig so every public member
          must carry an XML doc comment. The EnforceDocumentation property
          exists for CI scenarios that want to extend this to other rules.
        -->
        <WarningsAsErrors Condition="'$(EnforceDocumentation)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
    </PropertyGroup>
    <!--
      Windows-only platform declaration: lets WindowsToast.cs use the WinRT
      projection (Windows.UI.Notifications) in-process. The SDK auto-references
      Microsoft.Windows.SDK.NET.Ref and defines the WINDOWS symbol when the
      TargetPlatformIdentifier is windows. Scoped to a Windows host (any/no RID,
      so plain `dotnet build` / `dotnet test` work) or a win-* RID (covers the
      Gitea Linux runner's win-x64 publish). Linux/macOS builds stay plain
      net10.0 and compile the Windows toast body out via #if WINDOWS.
    -->
    <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-')) OR $([MSBuild]::IsOSPlatform('Windows'))">
        <TargetPlatformIdentifier>windows</TargetPlatformIdentifier>
        <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
        <!--
          Lets the Gitea Linux runner publish win-x64: building a windows-targeting
          project on a non-Windows host requires this (NETSDK1147). No-op on a
          Windows host; irrelevant to Linux/macOS RIDs (condition false there).
        -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.2" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
        <PackageReference Include="NLog" Version="6.2.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" Version="10.0.12" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Shoko.Companion.Tests" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="icon.ico" />
    </ItemGroup>
    <ItemGroup>
        <!-- Embedded PNG used for Linux notification / desktop-entry icons. -->
        <EmbeddedResource Include="icon.png">
            <LogicalName>shoko-companion.icon.png</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <!--
      Strip .pdb and .xml from publish output regardless of configuration.
      This keeps the published single-file binary clean while preserving doc
      generation (CS1591 enforcement) and debug symbols in all build configs.
    -->
    <Target Name="CleanPublishOutput" AfterTargets="Publish">
        <ItemGroup>
            <_PublishExtraFiles Include="$(PublishDir)*.pdb" />
            <_PublishExtraFiles Include="$(PublishDir)*.xml" />
        </ItemGroup>
        <Delete Files="@(_PublishExtraFiles)" />
    </Target>
</Project>
