<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shoko.Companion.Windows.AboutDialog"
        Title="About Shoko Companion"
        Width="380"
        Height="200"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="20">

        <!-- Top: icon + info side by side -->
        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto">

            <Image Name="AppIcon"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Shoko Companion"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="VersionText"
                           FontSize="13"
                           Foreground="{DynamicResource SystemAccentColor}"/>
                <TextBlock Text="MIT License"
                           FontSize="12"
                           Opacity="0.6"/>
            </StackPanel>
        </Grid>

        <!-- Bottom: repo link + close -->
        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Stretch">
            <TextBlock Name="RepoLink"
                       FontSize="12"
                       TextDecorations="Underline"
                       Foreground="{DynamicResource SystemAccentColor}"
                       Cursor="Hand"
                       Text="https://github.com/ShokoAnime/Shoko.Companion"
                       PointerPressed="OnRepoLinkClick"/>

            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="80"
                    Click="OnCloseClick"/>
        </StackPanel>

    </Grid>
</Window>
