<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shoko.Companion.Windows.ManageFoldersDialog"
        Title="Manage Folder Mappings"
        Width="640"
        Height="400"
        CanResize="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Connection selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Server:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox Name="ConnectionCombo" MinWidth="250"
                      SelectionChanged="OnConnectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" MinWidth="70"/>
        </StackPanel>

        <!-- Mapping list -->
        <ListBox Name="MappingListBox" Grid.Row="1"
                 SelectionMode="Single" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Spacing="2" Margin="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ServerPath}" Foreground="{StaticResource SystemAccentColor}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="→" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LocalPath}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Name="AddButton" Content="Add…" Click="OnAddClick" MinWidth="80"/>
            <Button Name="EditButton" Content="Edit…" Click="OnEditClick" MinWidth="80"/>
            <Button Name="RemoveButton" Content="Remove" Click="OnRemoveClick" MinWidth="80"/>

            <Button Name="CloseButton" Content="Close" Click="OnCloseClick"
                    HorizontalAlignment="Right" MinWidth="80"
                    IsDefault="True"
                    Margin="280,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>
