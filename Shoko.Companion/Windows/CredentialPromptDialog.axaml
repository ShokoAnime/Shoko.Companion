<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Shoko.Companion.Windows.CredentialPromptDialog"
        Title="Authentication Required"
        Width="420"
        Height="320"
        CanResize="False">
    <Grid RowDefinitions="*" Margin="16">
        <StackPanel Spacing="8">

            <TextBlock Name="TitleText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="API Key:" FontWeight="SemiBold"/>
            <TextBox Name="ApiKeyBox" Watermark="Paste your Shoko API key here"
                     TextChanged="OnApiKeyTextChanged"/>

            <Separator/>
            <TextBlock Text="Or login with username/password:" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,*">
                <TextBox Name="UsernameBox" Watermark="Username" Grid.Column="0" Margin="0,0,4,0"/>
                <TextBox Name="PasswordBox" Watermark="Password" PasswordChar="*" Grid.Column="1"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="LoginButton" Content="Login &amp; Fetch Key"
                        Click="OnLoginClick" HorizontalAlignment="Left"/>
            </StackPanel>

            <TextBlock Name="StatusText" FontSize="13" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                        Margin="0,12,0,0">
                <Button Name="SaveButton" Content="Save" Click="OnSaveClick" MinWidth="80" IsDefault="True"/>
                <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" MinWidth="80"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
